set positional-arguments

# temporal_agentic_factory — the Temporal runner package. Run `just` to list.

default:
    @just --list

# lint source and tests
lint:
    uv run ruff check src tests

# format source and tests
fmt:
    uv run ruff format src tests

# fail if anything needs formatting
fmt-check:
    uv run ruff format --check src tests

# static types
typecheck:
    uv run mypy src

# unit tests
test *ARGS:
    uv run pytest -q -p no:cacheprovider tests {{ARGS}}

# one command that says "green"
check: lint fmt-check typecheck test

# start the runner process that polls Temporal task queues; the beads poll schedule is
# (re)created first (its runs wait on the queue for this runner), so a restart always brings it back
runner *ARGS:
    {{schedule_start}}
    uv run factory runner "$@"

# start N runner processes in the background on this machine, each with its own log file: just runners 2;
# then (re)create the beads poll schedule
runners N="2":
    mkdir -p "{{runner_logs}}"
    for i in $(seq {{N}}); do nohup uv run factory runner > "{{runner_logs}}/runner-$(date +%Y%m%d-%H%M%S)-$i.log" 2>&1 & echo "runner $! started"; done
    {{schedule_start}}

# stop every runner process on this machine, each by its exact pid; Temporal retries the activities they were running
runners-stop:
    for pid in $(pgrep -f "[f]actory runner"); do kill "$pid" && echo "runner $pid stopped"; done

# start the one coders process in the background (one Temporal worker per provider, its
# [providers.<name>] max_concurrent coder runs at once), with its own log file
coders:
    mkdir -p "{{runner_logs}}"
    nohup uv run factory coders > "{{runner_logs}}/coders-$(date +%Y%m%d-%H%M%S).log" 2>&1 & echo "coders $! started"

# stop the coders process by its exact pid; it lets running coder jobs finish for up to [coders] graceful_shutdown_sec
coders-stop:
    for pid in $(pgrep -f '^(\S*python\S* |uv run )?(\S*/)?(factory|af) coders( |$)'); do kill "$pid" && echo "coders $pid stopped"; done

# start one job on Temporal and wait for it: just run "prompt" [--provider claude] [--model ...]
run *ARGS:
    uv run factory run "$@"

# Temporal dev server: one binary, SQLite file, web UI. Data survives restarts.
# Use the IP, not "localhost": that resolves to ::1 first on macOS and the server is IPv4 only.
temporal_data := env("XDG_DATA_HOME", env("HOME") + "/.local/share") + "/agentic_factory"
runner_logs := temporal_data + "/runner-logs"
# `af beads start`, a warning instead of a failure (Temporal down, no beads database yet)
schedule_start := "uv run factory beads start || echo 'warning: beads poll schedule not started; run `af beads start` once Temporal is up' >&2"
temporal_ip := "127.0.0.1"
temporal_port := "7233"
temporal_ui_port := "8233"

# install the `temporal` CLI (brew on macOS, official installer elsewhere)
temporal-install:
    #!/usr/bin/env bash
    set -euo pipefail
    if command -v temporal >/dev/null; then echo "temporal already installed: $(temporal --version)"; exit 0; fi
    if command -v brew >/dev/null; then brew install temporal; else curl -sSf https://temporal.download/cli.sh | sh; fi
    temporal --version

# start the local Temporal dev server: gRPC {{temporal_ip}}:{{temporal_port}}, UI :{{temporal_ui_port}}, history in {{temporal_data}}/temporal.db
# (then `just temporal-attributes` once, so the UI has the job columns)
temporal ui_ip=temporal_ip:
    #!/usr/bin/env bash
    set -euo pipefail
    command -v temporal >/dev/null || { echo "temporal CLI missing: run 'just temporal-install'"; exit 1; }
    mkdir -p "{{temporal_data}}"
    exec temporal server start-dev --ip {{temporal_ip}} --port {{temporal_port}} \
        --ui-ip {{ui_ip}} --ui-port {{temporal_ui_port}} --db-filename "{{temporal_data}}/temporal.db"

# same, with the UI on every interface: http://127.0.0.1:8233 here, http://<tailscale ip>:8233 from
# other tailnet devices (gRPC stays on 127.0.0.1)
temporal-tailscale:
    just temporal 0.0.0.0

# register the job's search attributes (Name, Provider, Model, Workdir, Runner, Outcome, Verdict) on the server: once per server
temporal-attributes:
    uv run factory attributes

# is the dev server up?
temporal-health:
    temporal operator cluster health --address {{temporal_ip}}:{{temporal_port}}
