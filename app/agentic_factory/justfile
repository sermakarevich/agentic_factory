set positional-arguments

# agentic_factory — the application package. Run `just` to list.

default:
    @just --list

# lint source and tests
lint:
    uv run ruff check src scripts tests

# format source and tests
fmt:
    uv run ruff format src scripts tests

# fail if anything needs formatting
fmt-check:
    uv run ruff format --check src scripts tests

# static types
typecheck:
    uv run mypy src scripts

# unit tests
test *ARGS:
    uv run pytest -q -p no:cacheprovider tests {{ARGS}}

# one command that says "green"
check: lint fmt-check typecheck test

# Run one llm job and watch its events: just run "prompt" [--provider claude] [--model ...]
run *ARGS:
    uv run python scripts/run_job.py "$@"

# Demo input for `just judge` with no arguments.
demo_state := "I was charged twice for the same order and nobody answers my emails. I want a refund today."
demo_questions := '{"tone":{"kind":"choice","question":"What is the tone?","options":{"calm":null,"angry":null}},"urgency":{"kind":"score","question":"How urgent is it?","levels":["can wait","this week","today"]},"billing":{"kind":"check","question":"Is this about billing?"}}'

# One judge step, typed questions over a state (TypeSafe jev API): just judge ["state" ["questions json or @file" [--model ...]]]
judge state=demo_state questions=demo_questions *ARGS:
    state="$1"; questions="$2"; shift 2; uv run python scripts/run_judge.py "$state" --questions "$questions" "$@"
