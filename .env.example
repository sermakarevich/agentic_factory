# Copy to .env (git-ignored) or export from your shell. Read on start by the
# `just` commands and the runner; ~/.env works too.

# OpenCode Go subscription key, the same one `opencode auth login` stores.
# Used for plain llm calls against https://opencode.ai/zen/go/v1.
OPENCODE_API_KEY=

# TypeSafe API key for judge steps (jev: typed questions answered with
# probabilities), the same one the `jev` cli uses. Paid per input token.
TYPESAFE_API_KEY=

# Any default of app/agentic_factory/src/agentic_factory/settings/settings.toml can be
# overridden here as AF_<TABLE>__<KEY>, for example:
# AF_STEP__MAX_TOKENS=4096
# AF_JOB__PROVIDER=claude

# Values shared by every package live in common/factory_settings/src/factory_settings/settings.toml,
# overridden the same way; the database, for example:
# AF_STORE__URL=postgresql+asyncpg://factory:factory@127.0.0.1:5432/factory
